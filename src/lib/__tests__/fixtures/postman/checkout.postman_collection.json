{
  "info": {
    "_postman_id": "0f6d2c1e-8a4b-4c7d-9e21-5b3f7a9c1d20",
    "name": "Checkout flow",
    "description": "Create an order, read it back, pay for it, and check the failure cases. Written for spec0 Studio's tests; the APIs are made up.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "demo-token-7f3a9c", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com/v1", "type": "string" },
    { "key": "paymentsUrl", "value": "https://payments.invalid/v1", "type": "string" },
    { "key": "customerId", "value": "cus_19", "type": "string" },
    { "key": "webhookSecret", "value": "demo-hook-secret-9f8e", "type": "string" }
  ],
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["console.log('Running ' + pm.info.requestName);"] } }
  ],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const order = pm.response.json();",
                  "pm.environment.set(\"orderId\", order.id);",
                  "pm.collectionVariables.set(\"orderTotal\", order.total.amount);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "checkout-{{customerId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"lineItems\": [\n    { \"sku\": \"abc\", \"quantity\": 2, \"unitPrice\": { \"amount\": 1999, \"currency\": \"EUR\" } }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":orderId"],
              "variable": [{ "key": "orderId", "value": "{{orderId}}" }]
            }
          }
        },
        {
          "name": "List paid orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/orders/?status=paid&limit=10&debug=true",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ""],
              "query": [
                { "key": "status", "value": "paid" },
                { "key": "limit", "value": "10" },
                { "key": "debug", "value": "true" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get a missing order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Unknown orders are 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().title).to.eql('Not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "auth": {
        "type": "apikey",
        "apikey": [
          { "key": "key", "value": "X-Payments-Key", "type": "string" },
          { "key": "value", "value": "demo-pay-key-2b8e41", "type": "string" },
          { "key": "in", "value": "header", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Pay for the order",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.variables.set(\"requestedAt\", new Date().toISOString());"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Payment created\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.environment.set(\"paymentId\", pm.response.json().id);",
                  "pm.environment.set(\"paymentLocation\", pm.response.headers.get(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": { \"amount\": {{orderTotal}}, \"currency\": \"EUR\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{paymentsUrl}}/payments"
          }
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Request-Id", "value": "{{$guid}}" }],
            "url": {
              "raw": "{{paymentsUrl}}/payments/{{paymentId}}",
              "host": ["{{paymentsUrl}}"],
              "path": ["payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Pay twice",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"Rejected\", () => pm.response.to.be.clientError);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"orderId\": \"{{orderId}}\", \"amount\": { \"amount\": 1, \"currency\": \"EUR\" } }",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{paymentsUrl}}/payments"
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
