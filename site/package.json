{
  "name": "@spec0/studio-docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Spec0 Studio user guide, built from docs/user as a static site.",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "next dev",
